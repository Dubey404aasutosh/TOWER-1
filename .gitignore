venv/
__pycache__/
*.pyc
.env
.DS_Store
*.log
.system_generated/

# Generated forensic/STR reports — regenerated per pipeline run, not source.
# The committed sample deliverables are the "sample_*" pair. Whitelisting them by
# a stable prefix rather than by timestamped filename means regenerating the
# samples does not silently drop them from the repo, which is what happened when
# these rules named two specific timestamps that later stopped existing.
reports/*.docx
backend/reports/*.docx
!backend/reports/sample_*.docx
